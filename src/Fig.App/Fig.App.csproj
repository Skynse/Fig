<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the .exe icon on Windows; drawn from assets/icon/fig-mono.svg -->
    <ApplicationIcon>Assets\fig.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    A release is one file: the app, .NET, the native libraries and FFmpeg, unpacked by .NET on first launch.
      dotnet publish src/Fig.App/Fig.App.csproj -c Release -r linux-x64 -p:FfmpegDir=path/to/ffmpeg-libs
    FfmpegDir holds just the FFmpeg libraries to ship (see .github/workflows/release.yml); they land in ffmpeg/,
    where MediaService looks.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <!--
    Whisper.net.Runtime copies whisper.cpp for every desktop platform into runtimes/; a release keeps only its own
    (about 2.5 MB). The speech models are not shipped: they download to ~/.fig/models on first use.
  -->
  <Target Name="KeepOwnWhisperRuntime" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/'))
                   And $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('whisper'))
                   And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/$(RuntimeIdentifier)/'))" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(FfmpegDir)' != ''">
    <None Include="$(FfmpegDir)\*" Link="ffmpeg\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- what a Linux release writes to put itself in the app menu (Services/DesktopIntegration.cs) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\linux\share\applications\io.github.skynse.Fig.desktop" LogicalName="linux-launcher" />
    <EmbeddedResource Include="..\..\packaging\linux\share\icons\hicolor\**\io.github.skynse.Fig.png" LogicalName="linux-icon:%(RecursiveDir)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fig.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
    <PackageReference Include="SoundFlow" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fig.Core\Fig.Core.csproj" />
  </ItemGroup>
</Project>
