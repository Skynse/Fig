<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Fig.App.ViewModels"
             xmlns:conv="using:Fig.App.Converters"
             xmlns:local="using:Fig.App.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="730"
             x:Name="Root"
             x:Class="Fig.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
        <SolidColorBrush x:Key="Muted" Color="#868a95"/>
        <SolidColorBrush x:Key="CardBg" Color="#212328"/>
        <SolidColorBrush x:Key="CardBorder" Color="Transparent"/>
        <SolidColorBrush x:Key="Hairline" Color="#2a2d34"/>
        <SolidColorBrush x:Key="Danger" Color="#ff7a7a"/>
        <!-- one menu for a project, right-clicked or from its ⋯ button, in either view (it takes the project it opens on) -->
        <MenuFlyout x:Key="ProjectActions" x:DataType="vm:ProjectItemViewModel" Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Open project" Command="{Binding OpenCommand}"/>
            <MenuItem Header="Rename" Command="{Binding RenameCommand}"/>
            <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}"/>
            <Separator/>
            <MenuItem Header="Delete project…" Foreground="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
        </MenuFlyout>
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateProjectCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Button.card">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.card:pointerover Border.thumb">
            <Setter Property="BorderBrush" Value="#6ea5ff"/>
        </Style>
        <Style Selector="Button.card:focus-visible Border.thumb">
            <Setter Property="BorderBrush" Value="#9cc0ff"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.row">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#212328"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#272a30"/>
        </Style>
        <Style Selector="Button.more">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b8bbc4"/>
            <Setter Property="ToolTip.Tip" Value="Project actions"/>
        </Style>
        <Style Selector="Button.more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30343b"/>
        </Style>
        <Style Selector="TextBlock.meta"><Setter Property="Foreground" Value="#868a95"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="TextBlock.kbd"><Setter Property="Foreground" Value="#868a95"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="TextBlock.kbdkey"><Setter Property="Foreground" Value="#b8bbc4"/><Setter Property="FontSize" Value="12"/></Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource SurfaceBg}" RowDefinitions="Auto,Auto,*,Auto" Margin="0">

        <!-- Header: title and primary actions -->
        <Grid Grid.Row="0" Margin="24,18,24,16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
            <TextBlock Text="Projects" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="fig" Width="148" Content="Import Project…"
                    Command="{Binding ImportOtioCommand}"
                    ToolTip.Tip="Open a shared Fig project (.figpck), or import an OpenTimelineIO (.otio) timeline, as a new project"/>
            <Button Grid.Column="2" Classes="fig primary" Width="148" Content="+ New Project"
                    Command="{Binding CreateProjectCommand}"
                    ToolTip.Tip="Create a new project (Ctrl+N)"/>
        </Grid>

        <!-- Toolbar: only when there is something to browse -->
        <Grid Grid.Row="1" Margin="24,20,24,16" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              IsVisible="{Binding HasProjects}">
            <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Recent projects" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Classes="meta" Text="{Binding CountText}"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Width="260" Margin="0,0,16,0"
                     PlaceholderText="Search projects" Text="{Binding SearchText}"
                     AutomationProperties.Name="Search projects"/>
            <ComboBox Grid.Column="2" Width="140" Margin="0,0,16,0"
                      ItemsSource="{x:Static vm:HomeViewModel.SortOptions}"
                      SelectedItem="{Binding SortBy}"
                      AutomationProperties.Name="Sort projects"
                      ToolTip.Tip="Sort projects"/>
            <ToggleButton Grid.Column="3" Classes="fig" Width="60" Content="Grid" Margin="0,0,8,0"
                          IsChecked="{Binding IsGrid, Mode=OneWay}"
                          Command="{Binding ShowGridCommand}"/>
            <ToggleButton Grid.Column="4" Classes="fig" Width="60" Content="List"
                          IsChecked="{Binding IsList, Mode=OneWay}"
                          Command="{Binding ShowListCommand}"/>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">

            <!-- First run -->
            <StackPanel IsVisible="{Binding HasNoProjects}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                <local:StrokeIcon Icon="clapperboard" Width="40" Height="40" HorizontalAlignment="Center"
                                  IconBrush="{StaticResource Muted}"/>
                <TextBlock Text="Create your first project" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Classes="meta" Text="Start a new edit or import an existing timeline." HorizontalAlignment="Center"/>
                <Button Classes="fig primary" Width="148" Content="+ New Project" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Command="{Binding CreateProjectCommand}"/>
            </StackPanel>

            <!-- Search matched nothing -->
            <StackPanel IsVisible="{Binding NoSearchResults}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <TextBlock Text="No projects match your search" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Classes="meta" Text="Check the spelling or clear the search." HorizontalAlignment="Center"/>
                <Button Classes="fig" Width="120" Content="Clear search" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Command="{Binding ClearSearchCommand}"/>
            </StackPanel>

            <!-- Grid view -->
            <ScrollViewer IsVisible="{Binding ShowProjects}" HorizontalScrollBarVisibility="Disabled">
                <Panel>
                    <ItemsControl ItemsSource="{Binding Projects}" Margin="24,0,8,24" IsVisible="{Binding IsGrid}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectItemViewModel">
                                <StackPanel Width="228" Margin="0,0,16,20">
                                    <Button Classes="card" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}" ContextFlyout="{StaticResource ProjectActions}">
                                        <Border Classes="thumb" Height="128" Background="{StaticResource CardBg}" CornerRadius="14"
                                                BorderBrush="Transparent" BorderThickness="2" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill"/>
                                                <StackPanel VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasThumbnail}">
                                                    <local:StrokeIcon Icon="clapperboard" Width="22" Height="22" HorizontalAlignment="Center" IconBrush="{StaticResource Muted}"/>
                                                    <TextBlock Classes="meta" Text="{Binding PlaceholderText}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,10,0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                        <Button Grid.Column="1" Classes="fig more" Content="⋯" AutomationProperties.Name="Project actions" Flyout="{StaticResource ProjectActions}"/>
                                    </Grid>
                                    <TextBlock Classes="meta" Margin="4,0,0,0" Text="{Binding LastEditedText, StringFormat='Last edited · {0}'}"/>
                                    <TextBlock Classes="meta" Margin="4,4,0,0" Text="{Binding DurationText, StringFormat='Duration · {0}'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- List view -->
                    <StackPanel IsVisible="{Binding IsList}" Margin="24,0,24,24">
                        <Grid ColumnDefinitions="*,200,120,40" Margin="16,4,16,10">
                            <TextBlock Classes="meta" Text="Project"/>
                            <TextBlock Classes="meta" Grid.Column="1" Text="Last edited"/>
                            <TextBlock Classes="meta" Grid.Column="2" Text="Duration"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectItemViewModel">
                                    <Grid Margin="0,0,0,8">
                                        <Button Classes="row" Height="60" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}" ContextFlyout="{StaticResource ProjectActions}">
                                            <Grid ColumnDefinitions="*,200,120,40" Margin="16,0">
                                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                                    <local:StrokeIcon Icon="clapperboard" Width="20" Height="20" IconBrush="{StaticResource Muted}"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Classes="meta" Grid.Column="1" VerticalAlignment="Center" Text="{Binding LastEditedText}"/>
                                                <TextBlock Classes="meta" Grid.Column="2" VerticalAlignment="Center" Text="{Binding DurationText}"/>
                                            </Grid>
                                        </Button>
                                        <Button Classes="fig more" HorizontalAlignment="Right" Margin="0,0,16,0" Content="⋯" AutomationProperties.Name="Project actions" Flyout="{StaticResource ProjectActions}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: shortcut hints -->
        <Border Grid.Row="3" Margin="24,0" Padding="0,14,0,16">
            <StackPanel Orientation="Horizontal" Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="kbdkey" Text="Enter"/><TextBlock Classes="kbd" Text="Open project"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="kbdkey" Text="/"/><TextBlock Classes="kbd" Text="Search"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="kbdkey" Text="Ctrl+N"/><TextBlock Classes="kbd" Text="New project"/></StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
