<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Fig.App.Views"
             xmlns:vm="using:Fig.App.ViewModels"
             x:Class="Fig.App.Views.GraphEditorView"
             x:DataType="vm:GraphEditorViewModel"
             Background="{DynamicResource SurfaceBg}">

    <Grid RowDefinitions="48,*,Auto,28">

        <!-- ================= top bar ================= -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="8,0">
                <Button Grid.Column="0" Classes="tool-btn" Command="{Binding BackCommand}" Padding="8,4"
                        ToolTip.Tip="Back to the editor" AutomationProperties.Name="Back">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <local:StrokeIcon Icon="chevron-left" Width="14" Height="14" IconBrush="{DynamicResource TextMuted}"/>
                        <TextBlock Text="Effects" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBox Grid.Column="1" Width="210" Height="28" MinHeight="28" Margin="8,0" VerticalAlignment="Center"
                         Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Effect name"
                         AutomationProperties.Name="Effect name"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="AddMenuButton" Classes="tool-btn" Padding="10,4" ToolTip.Tip="Add a node (Shift+A to search)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Add" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <local:StrokeIcon Icon="chevron-down" Width="12" Height="12" IconBrush="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditMenuButton" Classes="tool-btn" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Edit" Foreground="{DynamicResource TextMuted}"/>
                            <local:StrokeIcon Icon="chevron-down" Width="12" Height="12" IconBrush="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewMenuButton" Classes="tool-btn" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="View" Foreground="{DynamicResource TextMuted}"/>
                            <local:StrokeIcon Icon="chevron-down" Width="12" Height="12" IconBrush="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- validity is a symbol only; the tooltip lists problems -->
                    <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0"
                            ToolTip.Tip="{Binding ValidityTip}" AutomationProperties.Name="Validity"
                            Classes.ok="{Binding IsValid}" Classes.bad="{Binding !IsValid}" BorderThickness="1.5">
                        <Border.Styles>
                            <Style Selector="Border.ok">
                                <Setter Property="Background" Value="#17302a"/>
                                <Setter Property="BorderBrush" Value="#589b74"/>
                            </Style>
                            <Style Selector="Border.bad">
                                <Setter Property="Background" Value="#2a2510"/>
                                <Setter Property="BorderBrush" Value="#eab308"/>
                            </Style>
                        </Border.Styles>
                        <Grid>
                            <local:StrokeIcon Icon="check" Width="14" Height="14" StrokeWidth="2.2"
                                              IconBrush="#8bc9a3" IsVisible="{Binding IsValid}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <local:StrokeIcon Icon="triangle-alert" Width="14" Height="14" StrokeWidth="2"
                                              IconBrush="{DynamicResource Warn}" IsVisible="{Binding !IsValid}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Border}" Margin="0,0,6,0"/>
                    <Button Classes="tool-btn" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                        <local:StrokeIcon Icon="undo-2" Width="16" Height="16" IconBrush="{DynamicResource TextSecondary}"/>
                    </Button>
                    <Button Classes="tool-btn" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                        <local:StrokeIcon Icon="redo-2" Width="16" Height="16" IconBrush="{DynamicResource TextSecondary}"/>
                    </Button>
                    <Button Classes="tool-btn" Command="{Binding RevertCommand}" IsEnabled="{Binding IsDirty}"
                            ToolTip.Tip="Revert to the saved version" AutomationProperties.Name="Revert">
                        <local:StrokeIcon Icon="rotate-ccw" Width="16" Height="16" IconBrush="{DynamicResource TextSecondary}"/>
                    </Button>
                    <Button Classes="btn-primary" Command="{Binding SaveCommand}" IsEnabled="{Binding IsValid}"
                            Padding="10,6" ToolTip.Tip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                        <local:StrokeIcon Icon="save" Width="16" Height="16" IconBrush="#ffffff"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= canvas + inspector ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="*,360">
            <local:GraphCanvas x:Name="Canvas" Grid.Column="0" Editor="{Binding}"/>

            <Border Grid.Column="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14" Spacing="14">

                        <StackPanel Spacing="8">
                            <TextBlock Text="Preview" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <local:SplitPreview Before="{Binding BeforeImage}" After="{Binding AfterImage}" Split="0.5"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}"/>

                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Selected node" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding SelectedTitle}" Foreground="{DynamicResource AccentText}"/>
                            </StackPanel>
                            <TextBlock Text="Select a node to edit its values. Click the pin beside a value to expose it as a slider on the effect."
                                       Classes="empty-state" TextWrapping="Wrap"
                                       IsVisible="{Binding !HasSelectedNode}"/>
                            <ItemsControl ItemsSource="{Binding NodeParams}" IsVisible="{Binding HasSelectedNode}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NodeParamRow">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ContentControl Grid.Column="0" Content="{Binding Editor}"/>
                                            <Button Grid.Column="1" Classes="tool-btn" Command="{Binding TogglePinCommand}"
                                                    VerticalAlignment="Bottom" MinWidth="28" MinHeight="28" Padding="5" Margin="4,0,0,0"
                                                    ToolTip.Tip="Expose as a control on the effect">
                                                <Grid>
                                                    <local:StrokeIcon Icon="pin" Width="14" Height="14" IconBrush="{DynamicResource Accent}"
                                                                      IsVisible="{Binding IsPromoted}"/>
                                                    <local:StrokeIcon Icon="pin" Width="14" Height="14" IconBrush="{DynamicResource TextFaint}"
                                                                      IsVisible="{Binding !IsPromoted}"/>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}"/>

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Controls" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <Border Background="{DynamicResource ChipBg}" CornerRadius="8" Padding="6,1">
                                    <TextBlock Text="{Binding ExposedCount}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="empty-state" TextWrapping="Wrap" IsVisible="{Binding HasNoExposed}"
                                       Text="Nothing is exposed yet. Pin a value on a node to make it a slider."/>
                            <ItemsControl ItemsSource="{Binding Exposed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExposedControlRow">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Label, Mode=TwoWay}"
                                                         Height="26" MinHeight="26" Padding="6,2" FontWeight="Medium"
                                                         AutomationProperties.Name="Control name"/>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="0">
                                                    <Button Classes="tool-btn" Command="{Binding MoveUpCommand}" MinWidth="24" MinHeight="24" Padding="3">
                                                        <local:StrokeIcon Icon="chevron-up" Width="12" Height="12" IconBrush="{DynamicResource TextMuted}"/>
                                                    </Button>
                                                    <Button Classes="tool-btn" Command="{Binding MoveDownCommand}" MinWidth="24" MinHeight="24" Padding="3">
                                                        <local:StrokeIcon Icon="chevron-down" Width="12" Height="12" IconBrush="{DynamicResource TextMuted}"/>
                                                    </Button>
                                                    <Button Classes="tool-btn" Command="{Binding RemoveCommand}" MinWidth="24" MinHeight="24" Padding="3"
                                                            ToolTip.Tip="Stop exposing this value">
                                                        <local:StrokeIcon Icon="x" Width="12" Height="12" IconBrush="{DynamicResource Danger}"/>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Spacing="2">
                                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding Range}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                        <TextBlock Text="{Binding DefaultText}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="empty-state" TextWrapping="Wrap" IsVisible="{Binding HasExposed}"
                                       Text="These are the sliders the effect shows on a clip. They can be keyframed and saved in presets."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= problems ================= -->
        <Border Grid.Row="2" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource Warn}"
                BorderThickness="0,1,0,0" Padding="16,8" IsVisible="{Binding !IsValid}" MaxHeight="120">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphProblem">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <local:StrokeIcon Icon="triangle-alert" Width="12" Height="12" IconBrush="{DynamicResource Warn}"/>
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ================= status bar ================= -->
        <Border Grid.Row="3" Background="{DynamicResource Ruler}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" Margin="16,0"/>
        </Border>

        <!-- ================= unsaved changes ================= -->
        <Border Grid.RowSpan="4" Background="#aa000000" IsVisible="{Binding ConfirmClose}">
            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel Spacing="14">
                    <TextBlock Text="Save changes to this effect?" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Clips that use it will update when you save." Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Keep editing" Command="{Binding KeepEditingCommand}" Classes="btn-ghost"/>
                        <Button Content="Discard" Command="{Binding DiscardAndCloseCommand}" Classes="btn-danger"/>
                        <Button Content="Save" Command="{Binding SaveAndCloseCommand}" Classes="btn-primary"
                                IsEnabled="{Binding IsValid}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
