<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Fig.App.Views"
             xmlns:conv="using:Fig.App.Converters"
             xmlns:vm="using:Fig.App.ViewModels"

             xmlns:core="using:Fig.Core.Timeline"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="900"
             x:Class="Fig.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.tool-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Button.tool-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333333"/>
        </Style>
        <Style Selector="Button.tool-btn:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="ToggleButton.tool-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="ToggleButton.tool-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333333"/>
        </Style>
        <Style Selector="ToggleButton.tool-btn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#2a4a7a"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="Button.kf-btn">
            <Setter Property="Background" Value="#2a2a2b"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="Button.kf-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3a3b"/>
        </Style>
        <Style Selector="Button.kf-btn.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4a2020"/>
        </Style>
        <Style Selector="TextBlock.inspector-section">
            <Setter Property="Foreground" Value="#8a8a8a"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
        </Style>
        <Style Selector="Border.inspector-card">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>

        <!-- schema-driven parameter editors (implicit by VM type) -->
        <DataTemplate DataType="vm:DoubleParamEditorViewModel">
            <StackPanel Spacing="4" Margin="0,6,0,0">
                <DockPanel>
                    <TextBlock Text="{Binding Value, StringFormat={}{0:0.##}}" DockPanel.Dock="Right"
                               Foreground="#dddddd" FontSize="11"/>
                    <TextBlock Text="{Binding Label}" Foreground="#bbbbbb" FontSize="12"/>
                </DockPanel>
                <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                        TickFrequency="0.01" IsSnapToTickEnabled="False"/>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowKeyframes}">
                    <Border Background="#2a2510" CornerRadius="4" Padding="6,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <local:StrokeIcon Icon="diamond" Width="12" Height="12" IconBrush="#eab308"/>
                            <TextBlock Text="{Binding KeyframeCount}" Foreground="#eab308" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="kf-btn" Command="{Binding AddKeyframeCommand}" ToolTip.Tip="Keyframe at playhead">
                        <local:StrokeIcon Icon="plus" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="kf-btn" Command="{Binding StepKeyframesCommand}" CommandParameter="False"
                            ToolTip.Tip="Previous keyframe">
                        <local:StrokeIcon Icon="chevron-left" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="kf-btn" Command="{Binding StepKeyframesCommand}" CommandParameter="True"
                            ToolTip.Tip="Next keyframe">
                        <local:StrokeIcon Icon="chevron-right" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="kf-btn danger" Command="{Binding ClearKeyframesCommand}"
                            ToolTip.Tip="Clear keyframes">
                        <local:StrokeIcon Icon="x" Width="14" Height="14" IconBrush="#ff6b6b"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BoolParamEditorViewModel">
            <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                <CheckBox Grid.Column="0" IsChecked="{Binding Value}" Content="{Binding Label}"
                          Foreground="#bbbbbb" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowKeyframes}">
                    <Border Background="#2a2510" CornerRadius="4" Padding="6,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <local:StrokeIcon Icon="diamond" Width="12" Height="12" IconBrush="#eab308"/>
                            <TextBlock Text="{Binding KeyframeCount}" Foreground="#eab308" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="kf-btn" Command="{Binding AddKeyframeCommand}" ToolTip.Tip="Keyframe at playhead">
                        <local:StrokeIcon Icon="plus" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="kf-btn danger" Command="{Binding ClearKeyframesCommand}" ToolTip.Tip="Clear keyframes">
                        <local:StrokeIcon Icon="x" Width="14" Height="14" IconBrush="#ff6b6b"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:ColorParamEditorViewModel">
            <StackPanel Spacing="4" Margin="0,6,0,0">
                <TextBlock Text="{Binding Label}" Foreground="#bbbbbb" FontSize="12"/>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Margin="0,0,8,0"
                            BorderBrush="#555555" BorderThickness="1"
                            Background="{Binding SwatchBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Hex}" FontSize="11"
                             Foreground="#dddddd" Background="#252526" BorderBrush="#333333"
                             Padding="8,6" CornerRadius="4" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
                                IsVisible="{Binding ShowKeyframes}" VerticalAlignment="Center">
                        <Button Classes="kf-btn" Command="{Binding AddKeyframeCommand}" ToolTip.Tip="Keyframe at playhead">
                            <local:StrokeIcon Icon="plus" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ChoiceParamEditorViewModel">
            <StackPanel Spacing="4" Margin="0,6,0,0">
                <TextBlock Text="{Binding Label}" Foreground="#bbbbbb" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding Index}"
                          FontSize="11" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.DataTemplates>

    <DockPanel Margin="8" Background="#1e1e1e"
               DragDrop.AllowDrop="True"
               DragDrop.DragOver="OnFileDragOver"
               DragDrop.Drop="OnFileDrop">

        <Menu DockPanel.Dock="Top" Margin="0,0,0,4" Background="Transparent">
            <MenuItem Header="_File">
                <MenuItem Header="_Import..." Command="{Binding ImportCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <MenuItem Header="_Export..." Command="{Binding ExportCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <Separator/>
                <MenuItem Header="_Close Project" Click="CloseProjectMenu_Click" InputGesture="Ctrl+W"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenu_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y">
                    <MenuItem.Icon>
                        <local:StrokeIcon Icon="redo" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="S_plit at Playhead" Command="{Binding SplitAtPlayheadCommand}"
                          InputGesture="Ctrl+K">
                    <MenuItem.Icon>
                        <local:StrokeIcon Icon="split" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Ripple Delete" Command="{Binding RippleDeleteSelectedCommand}">
                    <MenuItem.Icon>
                        <local:StrokeIcon Icon="ripple" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Lift Delete" Command="{Binding LiftSelectedCommand}">
                    <MenuItem.Icon>
                        <local:StrokeIcon Icon="lift" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Add _Marker at Playhead" Command="{Binding AddMarkerAtPlayheadCommand}"
                          InputGesture="M"/>
                <MenuItem Header="_Delete Marker" Command="{Binding DeleteSelectedMarkerCommand}"
                          InputGesture="Shift+Delete"/>
                <MenuItem Header="_Enable / Disable Clip" Command="{Binding ToggleClipEnabledSelectedCommand}"
                          InputGesture="Ctrl+E"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6"
                Background="#252526" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="{Binding Project.Name}"
                           VerticalAlignment="Center"
                           Foreground="#cccccc" FontWeight="SemiBold"
                           Margin="4,0,12,0"/>
                <Button DockPanel.Dock="Right" Content="Import"
                        Command="{Binding ImportCommand}"
                        CommandParameter="{Binding $parent[Window]}"/>
                <Button DockPanel.Dock="Right" Content="Export"
                        Command="{Binding ExportCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Margin="0,0,8,0"/>
                <Button x:Name="JobsButton" DockPanel.Dock="Right"
                        Command="{Binding ToggleJobsCommand}"
                        ToolTip.Tip="Export jobs"
                        Margin="0,0,8,0" Padding="8,4"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <local:StrokeIcon Icon="download" Width="14" Height="14" IconBrush="#cccccc"/>
                        <TextBlock Text="{Binding ActiveExportCount}" Foreground="#cccccc"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Popup IsOpen="{Binding IsJobsOpen}"
                       PlacementTarget="{Binding #JobsButton}"
                       Placement="Bottom">
                    <Border Background="#252526" CornerRadius="6"
                            BorderBrush="#333333" BorderThickness="1"
                            Padding="10" MinWidth="300" MaxWidth="360" MaxHeight="380">
                        <StackPanel Spacing="6">
                            <TextBlock Text="EXPORT JOBS" Foreground="#8a8a8a"
                                       FontSize="10" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Exports.Jobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExportJob">
                                        <Border Background="#1e1e1e" CornerRadius="4"
                                                Padding="8" Margin="0,0,0,6">
                                            <StackPanel Spacing="3">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}"
                                                               Foreground="#8a8a8a" FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="#dddddd" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                             Height="5" Foreground="#4d8dff" Background="#333333"/>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                                               Foreground="#6a6a6a" FontSize="10"/>
                                                    <TextBlock Text="{Binding Error}" Foreground="#ff6b6b"
                                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No export jobs yet." Foreground="#6a6a6a"
                                       FontSize="11" IsVisible="{Binding ShowEmptyJobs}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </DockPanel>
        </Border>

        <Grid RowDefinitions="*,4,520" ColumnDefinitions="2*,4,3*">

            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0"
                    Padding="0" Background="#252526" CornerRadius="6"
                    ClipToBounds="True">
                <DockPanel>
                    <!-- Vertical icon tabs: Media / Transitions / Effects -->
                    <Border DockPanel.Dock="Left" Width="44" Background="#1e1e1e"
                            BorderBrush="#333333" BorderThickness="0,0,1,0">
                        <ListBox ItemsSource="{Binding LibraryTabs}"
                                 SelectedItem="{Binding SelectedLibraryTab}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4,6">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#333333"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#2a4a7a"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#2a4a7a"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryTabItem">
                                    <Border Width="36" Height="36" ToolTip.Tip="{Binding Title}">
                                        <local:StrokeIcon Icon="{Binding Icon}"
                                                          Width="18" Height="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IconBrush="#dddddd"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <DockPanel Margin="10,8,8,8">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LibraryPanelTitle}"
                                   Foreground="#cccccc"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <!-- Media browser -->
                        <ListBox x:Name="MediaBox" IsVisible="{Binding IsLibraryMedia}" DragDrop.AllowDrop="True"
                                 ItemsSource="{Binding Media}"
                                 SelectedItem="{Binding SelectedMedia}"
                                 Background="Transparent"
                                 DragDrop.Drop="OnFileDrop"
                                 DragDrop.DragOver="OnFileDragOver"
                                 BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerTheme>
                                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </ControlTheme>
                            </ListBox.ItemContainerTheme>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Margin="4" Padding="0"
                                            Background="#1e1e1e" CornerRadius="6"
                                            BorderBrush="#333333" BorderThickness="1"
                                            ClipToBounds="True"
                                            Tag="{Binding}"
                                            PointerPressed="MediaCard_PointerPressed"
                                            PointerMoved="MediaCard_PointerMoved"
                                            PointerReleased="MediaCard_PointerReleased">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Generate Proxy"
                                                          Command="{Binding #MediaBox.DataContext.GenerateProxyCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Remove"
                                                          Command="{Binding #MediaBox.DataContext.RemoveMediaCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <Grid Height="90">
                                                <Border Background="#111111">
                                                    <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmap}}"
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="4" Padding="4,1"
                                                        Background="#000000a0" CornerRadius="3">
                                                    <TextBlock Text="{Binding DurationSec, Converter={x:Static conv:SecondsToTimeConverter.Instance}}"
                                                               Foreground="#ffffff" FontSize="11"/>
                                                </Border>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Margin="4" Padding="5,1"
                                                        Background="#2a4a7a" CornerRadius="3"
                                                        IsVisible="{Binding HasProxy}"
                                                        ToolTip.Tip="Playback proxy ready">
                                                    <TextBlock Text="Proxy"
                                                               Foreground="#ffffff" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="#dddddd"
                                                       FontSize="12"
                                                       Margin="6,4"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding FileName}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Effects catalog -->
                        <ScrollViewer IsVisible="{Binding IsLibraryEffects}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding EffectCatalogItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:EffectCatalogEntry">
                                        <Border Width="128" Margin="4" Padding="8"
                                                Background="#1e1e1e" CornerRadius="6"
                                                BorderBrush="#333333" BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip.Tip="Drag onto a video clip"
                                                PointerPressed="CatalogCard_PointerPressed"
                                                PointerMoved="CatalogCard_PointerMoved"
                                                PointerReleased="CatalogCard_PointerReleased">
                                            <StackPanel Spacing="6">
                                                <local:StrokeIcon Icon="{Binding Icon}" Width="22" Height="22"
                                                                  HorizontalAlignment="Center"
                                                                  IconBrush="#dddddd"/>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#dddddd"
                                                           FontSize="12" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#777777"
                                                           FontSize="10" TextWrapping="Wrap"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Transitions catalog -->
                        <ScrollViewer IsVisible="{Binding IsLibraryTransitions}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TransitionCatalogItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:TransitionCatalogEntry">
                                        <Border Width="128" Margin="4" Padding="8"
                                                Background="#1e1e1e" CornerRadius="6"
                                                BorderBrush="#333333" BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip.Tip="Drag onto a cut between clips"
                                                PointerPressed="CatalogCard_PointerPressed"
                                                PointerMoved="CatalogCard_PointerMoved"
                                                PointerReleased="CatalogCard_PointerReleased">
                                            <StackPanel Spacing="6">
                                                <local:StrokeIcon Icon="{Binding Icon}" Width="22" Height="22"
                                                                  HorizontalAlignment="Center"
                                                                  IconBrush="#dddddd"/>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#dddddd"
                                                           FontSize="12" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#777777"
                                                           FontSize="10" TextWrapping="Wrap"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="1"
                          Width="4" Margin="0,0,0,0"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <Border Grid.Row="0" Grid.Column="2" Margin="0,0,0,0"
                    Padding="8" Background="#252526" CornerRadius="6">
                <local:PreviewView x:Name="PreviewHost"
                                   DataContext="{Binding Preview}"/>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Height="4" Margin="0,0,0,0"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"
                          ShowsPreview="True"/>

            <!-- Timeline row: tracks on the left, contextual properties on the right -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                  ColumnDefinitions="*,4,300">

                <Border Grid.Column="0"
                        Padding="8" Background="#252526" CornerRadius="6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="2,2"
                                Background="#1e1e1e" CornerRadius="4" BorderBrush="#333333" BorderThickness="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tool-btn" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)">
                                        <local:StrokeIcon Icon="undo" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)">
                                        <local:StrokeIcon Icon="redo" Width="18" Height="18"/>
                                    </Button>
                                    <Rectangle Width="1" Height="22" Fill="#3a3a3a" Margin="4,4"/>
                                    <Button Classes="tool-btn" Command="{Binding SplitAtPlayheadCommand}"
                                            ToolTip.Tip="Split at playhead (Ctrl+K)">
                                        <local:StrokeIcon Icon="split" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding LiftSelectedCommand}"
                                            ToolTip.Tip="Lift delete (Delete)">
                                        <local:StrokeIcon Icon="lift" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding RippleDeleteSelectedCommand}"
                                            ToolTip.Tip="Ripple delete">
                                        <local:StrokeIcon Icon="ripple" Width="18" Height="18"/>
                                    </Button>
                                    <Rectangle Width="1" Height="22" Fill="#3a3a3a" Margin="4,4"/>
                                    <Button Classes="tool-btn" Command="{Binding AddMarkerAtPlayheadCommand}"
                                            ToolTip.Tip="Add marker (M)">
                                        <local:StrokeIcon Icon="marker" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding DeleteSelectedMarkerCommand}"
                                            ToolTip.Tip="Delete marker (Shift+Delete)">
                                        <local:StrokeIcon Icon="trash" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="tool-btn" Command="{Binding ToggleClipEnabledSelectedCommand}"
                                            ToolTip.Tip="Enable / disable clip (Ctrl+E)">
                                        <local:StrokeIcon Icon="eye-off" Width="18" Height="18"/>
                                    </Button>
                                    <Rectangle Width="1" Height="22" Fill="#3a3a3a" Margin="4,4"/>
                                    <ToggleButton Classes="tool-btn" IsChecked="{Binding MagneticSnap}"
                                                  ToolTip.Tip="Magnetic snap">
                                        <local:StrokeIcon Icon="magnet" Width="18" Height="18"/>
                                    </ToggleButton>
                                    <Rectangle Width="1" Height="22" Fill="#3a3a3a" Margin="4,4"/>
                                    <Button Classes="tool-btn" Click="TimelineZoomOut_Click" ToolTip.Tip="Zoom out">
                                        <local:StrokeIcon Icon="zoom-out" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="tool-btn" Click="TimelineZoomIn_Click" ToolTip.Tip="Zoom in">
                                        <local:StrokeIcon Icon="zoom-in" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="tool-btn" Click="TimelineZoomFit_Click"
                                            ToolTip.Tip="Zoom to fit sequence">
                                        <local:StrokeIcon Icon="maximize-2" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <local:TimelineView x:Name="Timeline"
                                             Editor="{Binding Editor}"
                                             MediaById="{Binding MediaById}"
                                             Gestures="{Binding Gestures}"
                                             ClipToBounds="True"/>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="Transparent"
                              ShowsPreview="True"/>

                <Border Grid.Column="2"
                        Padding="10,8" Background="#252526" CornerRadius="6">
                    <DockPanel DataContext="{Binding Properties}">
                        <Border DockPanel.Dock="Top" Classes="inspector-card" Margin="0,0,0,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="#eeeeee"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="#8a8a8a"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                                <Border Classes="inspector-card" IsVisible="{Binding ShowClipSection}">
                                    <StackPanel Spacing="8">
                                    <TextBlock Classes="inspector-section" Text="CLIP"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Timeline" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding ClipTimingLabel}" Foreground="#dddddd" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding SourceRangeLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="Source" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding SourceRangeLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding ShowVideoControls}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding OpacityValue, StringFormat={}{0:P0}}"
                                                       DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                            <TextBlock Text="Opacity" Foreground="#8a8a8a" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding OpacityValue}"
                                                TickFrequency="0.01" IsSnapToTickEnabled="False"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding ShowFadeControls}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding FadeInValue, StringFormat={}{0:0.00}s}"
                                                       DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                            <TextBlock Text="Fade In" Foreground="#8a8a8a" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="5" Value="{Binding FadeInValue}"
                                                TickFrequency="0.05" IsSnapToTickEnabled="False"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding ShowFadeControls}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding FadeOutValue, StringFormat={}{0:0.00}s}"
                                                       DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                            <TextBlock Text="Fade Out" Foreground="#8a8a8a" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="5" Value="{Binding FadeOutValue}"
                                                TickFrequency="0.05" IsSnapToTickEnabled="False"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding ShowAudioControls}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding VolumeValue, StringFormat={}{0:P0}}"
                                                       DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                            <TextBlock Text="Volume" Foreground="#8a8a8a" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding VolumeValue}"
                                                TickFrequency="0.01" IsSnapToTickEnabled="False"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding ShowVideoControls}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Reset"
                                                    Command="{Binding ResetCropCommand}"
                                                    Padding="8,2" FontSize="11"
                                                    Background="#333333" Foreground="#cccccc"
                                                    BorderThickness="0" CornerRadius="3"/>
                                            <TextBlock Text="CROP" Foreground="#8a8a8a" FontSize="10" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Spacing="2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding CropTop, StringFormat={}{0:P0}}"
                                                           DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                                <TextBlock Text="Top" Foreground="#8a8a8a" FontSize="11"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="0.45" Value="{Binding CropTop}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding CropBottom, StringFormat={}{0:P0}}"
                                                           DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                                <TextBlock Text="Bottom" Foreground="#8a8a8a" FontSize="11"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="0.45" Value="{Binding CropBottom}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding CropLeft, StringFormat={}{0:P0}}"
                                                           DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                                <TextBlock Text="Left" Foreground="#8a8a8a" FontSize="11"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="0.45" Value="{Binding CropLeft}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding CropRight, StringFormat={}{0:P0}}"
                                                           DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                                <TextBlock Text="Right" Foreground="#8a8a8a" FontSize="11"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="0.45" Value="{Binding CropRight}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="inspector-card" IsVisible="{Binding ShowEffectsSection}">
                                    <StackPanel Spacing="8">
                                    <TextBlock Classes="inspector-section" Text="EFFECTS"/>
                                    <ListBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EffectItemViewModel">
                                                <Border Padding="8,6" CornerRadius="4"
                                                        Background="#252526" BorderBrush="#333333" BorderThickness="1">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                                                            <ToggleButton IsChecked="{Binding IsEnabled}"
                                                                          Command="{Binding ToggleCommand}"
                                                                          ToolTip.Tip="Enable / disable"
                                                                          Classes="tool-btn" Padding="5">
                                                                <local:StrokeIcon Icon="power" Width="14" Height="14"/>
                                                            </ToggleButton>
                                                            <Button Command="{Binding RemoveCommand}"
                                                                    ToolTip.Tip="Remove effect"
                                                                    Classes="tool-btn" Padding="5">
                                                                <local:StrokeIcon Icon="x" Width="14" Height="14" IconBrush="#ff6b6b"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <local:StrokeIcon Icon="{Binding Icon}" Width="16" Height="16"
                                                                              IconBrush="#4da3ff" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#eeeeee"
                                                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Background="#252526" CornerRadius="4" Padding="10,8"
                                            BorderBrush="#3a3a3a" BorderThickness="1"
                                            IsVisible="{Binding SelectedEffect, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding SelectedEffect.DisplayName}"
                                                       Foreground="#4da3ff" FontSize="12" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding EffectParams}"/>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </Border>

                                <Border Classes="inspector-card" IsVisible="{Binding ShowTrackSection}">
                                    <StackPanel Spacing="8">
                                    <TextBlock Classes="inspector-section" Text="TRACK"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Name" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding TrackNameLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Type" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding KindLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding TrackFlagsLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="State" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding TrackFlagsLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="inspector-card" IsVisible="{Binding ShowMarkerSection}">
                                    <StackPanel Spacing="8">
                                    <TextBlock Classes="inspector-section" Text="MARKER"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Name" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBox Text="{Binding MarkerName}"
                                                 Foreground="#dddddd" Background="#1e1e1e"
                                                 BorderBrush="#333333" BorderThickness="1"
                                                 CornerRadius="3" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Time" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding MarkerTimeLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Duration" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding MarkerDurationLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" Margin="0,6,0,0">
                                        <TextBlock Text="Color" Foreground="#8a8a8a" FontSize="11"/>
                                        <ItemsControl ItemsSource="{Binding MarkerPalette}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="20" Height="20" Margin="0,0,6,6"
                                                            CornerRadius="10" BorderThickness="0"
                                                            Background="{Binding}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.SetMarkerColorCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="inspector-card" IsVisible="{Binding ShowTransitionSection}">
                                    <StackPanel Spacing="8">
                                    <TextBlock Classes="inspector-section" Text="TRANSITION"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Type" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding TransitionTypeLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <DockPanel>
                                            <TextBlock Text="{Binding TransitionDurationValue, StringFormat={}{0:0.00}s}"
                                                       DockPanel.Dock="Right" Foreground="#dddddd" FontSize="11"/>
                                            <TextBlock Text="Duration" Foreground="#8a8a8a" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0.05" Maximum="{Binding TransitionMaxDuration}"
                                                Value="{Binding TransitionDurationValue}"
                                                TickFrequency="0.05" IsSnapToTickEnabled="False"/>
                                        <TextBlock Text="{Binding TransitionSpanLabel}" Foreground="#8a8a8a" FontSize="11"/>
                                    </StackPanel>
                                    <Button Command="{Binding RemoveTransitionCommand}"
                                            Margin="0,6,0,0" Padding="10,6" FontSize="11"
                                            Background="#3a1f22" Foreground="#ff6b6b"
                                            BorderThickness="0" CornerRadius="4"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <local:StrokeIcon Icon="trash" Width="14" Height="14" IconBrush="#ff6b6b"/>
                                            <TextBlock Text="Remove transition" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding TransitionParams}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="inspector-card"
                                        IsVisible="{Binding FileName, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="8">
                                    <TextBlock Classes="inspector-section" Text="SOURCE"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="File" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding FileName}" Foreground="#dddddd" FontSize="12"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding FileName}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,8,8"
                                                    IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Kind" Foreground="#8a8a8a" FontSize="11"/>
                                            <TextBlock Text="{Binding KindLabel}" Foreground="#dddddd" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,8"
                                                    IsVisible="{Binding ResolutionLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Resolution" Foreground="#8a8a8a" FontSize="11"/>
                                            <TextBlock Text="{Binding ResolutionLabel}" Foreground="#dddddd" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2"
                                                    IsVisible="{Binding DurationLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Duration" Foreground="#8a8a8a" FontSize="11"/>
                                            <TextBlock Text="{Binding DurationLabel}" Foreground="#dddddd" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="inspector-card" IsVisible="{Binding ShowProxySection}">
                                    <StackPanel Spacing="8">
                                    <TextBlock Classes="inspector-section" Text="PROXY"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Status" Foreground="#8a8a8a" FontSize="11"/>
                                        <TextBlock Text="{Binding ProxyStatusLabel}" Foreground="#dddddd" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProxyDetail}"
                                               Foreground="#8a8a8a" FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <Button Content="{Binding ProxyActionLabel}"
                                            Command="{Binding GenerateProxyCommand}"
                                            IsEnabled="{Binding CanGenerateProxy}"
                                            HorizontalAlignment="Stretch"
                                            Padding="10,8"
                                            Background="#2a4a7a"
                                            Foreground="#ffffff"
                                            BorderThickness="0"
                                            CornerRadius="4"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
