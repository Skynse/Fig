<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Fig.App.Views"
             xmlns:conv="using:Fig.App.Converters"
             xmlns:vm="using:Fig.App.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Fig.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
        <conv:SecondsToTimeConverter x:Key="SecondsToTime"/>
    </UserControl.Resources>

    <DockPanel Margin="8" Background="#1e1e1e">

        <!-- toolbar pinned to top -->
        <Menu DockPanel.Dock="Top" Margin="0,0,0,4" Background="Transparent">
            <MenuItem Header="_File">
                <MenuItem Header="_Import..." Command="{Binding ImportCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenu_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y">
                    <MenuItem.Icon>
                        <PathIcon Data="{Binding IconRedo}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="S_plit at Playhead" Command="{Binding SplitAtPlayheadCommand}"
                          InputGesture="Ctrl+K">
                    <MenuItem.Icon>
                        <PathIcon Data="{Binding IconSplit}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Ripple Delete" Command="{Binding RippleDeleteSelectedCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{Binding IconRipple}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6"
                Background="#252526" CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Import"
                        Command="{Binding ImportCommand}"
                        CommandParameter="{Binding $parent[Window]}"/>
                <Rectangle Width="1" Height="20" Fill="#3a3a3a" Margin="8,0"/>
                <Button Command="{Binding UndoCommand}" ToolTip.Tip="Undo"
                        Background="Transparent" BorderThickness="0" Padding="6" Foreground="#cccccc">
                    <PathIcon Data="{Binding IconUndo}" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding RedoCommand}" ToolTip.Tip="Redo"
                        Background="Transparent" BorderThickness="0" Padding="6" Foreground="#cccccc">
                    <PathIcon Data="{Binding IconRedo}" Width="18" Height="18"/>
                </Button>
                <Rectangle Width="1" Height="20" Fill="#3a3a3a" Margin="8,0"/>
                <Button Command="{Binding SplitAtPlayheadCommand}" ToolTip.Tip="Split at playhead"
                        Background="Transparent" BorderThickness="0" Padding="6" Foreground="#cccccc">
                    <PathIcon Data="{Binding IconSplit}" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding RippleDeleteSelectedCommand}" ToolTip.Tip="Ripple delete"
                        Background="Transparent" BorderThickness="0" Padding="6" Foreground="#cccccc">
                    <PathIcon Data="{Binding IconRipple}" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- main two-column area + timeline -->
        <Grid RowDefinitions="*,180" ColumnDefinitions="2*,3*">

            <!-- media library -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                    Padding="8" Background="#252526" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Media Library"
                               Foreground="#cccccc"
                               FontSize="14" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Media}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="160" Margin="4" Padding="0"
                                        Background="#1e1e1e" CornerRadius="6"
                                        BorderBrush="#333333" BorderThickness="1"
                                        ClipToBounds="True"
                                        Tag="{Binding}"
                                        PointerPressed="MediaCard_PointerPressed"
                                        PointerMoved="MediaCard_PointerMoved"
                                        PointerReleased="MediaCard_PointerReleased">
                                    <StackPanel>
                                        <Grid Height="90">
                                            <Border Background="#111111">
                                                <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmap}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="4" Padding="4,1"
                                                    Background="#000000a0" CornerRadius="3">
                                                <TextBlock Text="{Binding DurationSec, Converter={StaticResource SecondsToTime}}"
                                                           Foreground="#ffffff" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="#dddddd"
                                                   FontSize="12"
                                                   Margin="6,4"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding FileName}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- preview -->
            <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                    Padding="8" Background="#252526" CornerRadius="6">
                <TextBlock Text="Preview"
                           Foreground="#cccccc"
                           FontSize="14" FontWeight="SemiBold" />
            </Border>

            <!-- timeline -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Padding="8" Background="#252526" CornerRadius="6">
                <local:TimelineView Editor="{Binding Editor}"
                                     MediaById="{Binding MediaById}"
                                     Gestures="{Binding Gestures}"
                                     ClipToBounds="True"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
