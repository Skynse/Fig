<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fig.App.ViewModels"
        x:Class="Fig.App.Views.ExportJobsWindow"
        x:DataType="vm:EditorViewModel"
        Icon="/Assets/fig.ico"
        Title="Export jobs"
        Width="560" MinHeight="220" MaxHeight="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#1D1E20">
    <Window.Styles>
        <Style Selector="ProgressBar.job">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Foreground" Value="#6ea5ff"/>
            <Setter Property="Background" Value="#0e0f11"/>
        </Style>
        <Style Selector="ProgressBar.job.done"><Setter Property="Foreground" Value="#7FC8A0"/></Style>
    </Window.Styles>

    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="Export jobs" FontSize="15" FontWeight="SemiBold"/>

        <TextBlock IsVisible="{Binding ShowEmptyJobs}" Foreground="#8A8A8A" FontSize="12"
                   Text="Nothing is exporting. Use Export in the toolbar to render the timeline."/>

        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasExportJobs}">
            <ItemsControl ItemsSource="{Binding Exports.Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExportJob">
                        <StackPanel Spacing="8" Margin="0,0,10,18">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="#8A8A8A" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="fig" Padding="10,3" MinHeight="0" FontSize="11" Content="Cancel"
                                        Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" IsEnabled="{Binding !IsCancelling}"
                                        ToolTip.Tip="Stop this export and delete what it wrote" AutomationProperties.Name="Cancel export"/>
                            </Grid>
                            <ProgressBar Classes="job" Classes.done="{Binding IsDone}" Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                            <TextBlock IsVisible="{Binding HasError}" Text="{Binding Error}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="You can continue editing while these export." Foreground="#8A8A8A" FontSize="12" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="fig" Width="110" Content="Close" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </StackPanel>
</Window>
