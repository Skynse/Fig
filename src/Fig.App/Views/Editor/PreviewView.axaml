<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Fig.App.ViewModels"
             xmlns:local="using:Fig.App.Views"
             xmlns:ctrls="using:Fig.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
             x:Class="Fig.App.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">

    <UserControl.Styles>
        <Style Selector="Button.monitor-btn">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Foreground" Value="#b8bbc4"/>
        </Style>
        <Style Selector="Button.monitor-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#30343b"/>
        </Style>
        <Style Selector="Button.monitor-play">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="#30343b"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Foreground" Value="#ececef"/>
        </Style>
        <Style Selector="Button.monitor-play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#383c44"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#0e0f11" CornerRadius="12" ClipToBounds="True">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBg}" Padding="12,5">
                <Grid ColumnDefinitions="*,Auto,*" MinHeight="32">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeDisplay}"
                                   Foreground="#b8bbc4" FontSize="11"
                                   FontFamily="monospace" VerticalAlignment="Center"/>
                        <local:StrokeIcon Icon="loader-circle" Width="13" Height="13"
                                          IsVisible="{Binding IsBuffering}"
                                          ToolTip.Tip="Buffering preview"
                                          IconBrush="#7db1ff"/>
                        <local:StrokeIcon Icon="circle-alert" Width="13" Height="13"
                                          IsVisible="{Binding HasPlaybackError}"
                                          ToolTip.Tip="Playback unavailable"
                                          IconBrush="#ff6b6b"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Classes="monitor-btn" Command="{Binding JumpToStartCommand}"
                                ToolTip.Tip="Jump to start">
                            <local:StrokeIcon Icon="skip-start" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="monitor-btn" Command="{Binding StepBackFrameCommand}"
                                ToolTip.Tip="Previous frame">
                            <local:StrokeIcon Icon="step-back" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="monitor-play" Command="{Binding TogglePlaybackCommand}"
                                ToolTip.Tip="Play / pause">
                            <local:StrokeIcon Icon="{Binding PlaybackIconKey}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="monitor-btn" Command="{Binding StepForwardFrameCommand}"
                                ToolTip.Tip="Next frame">
                            <local:StrokeIcon Icon="step-forward" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="monitor-btn" Command="{Binding JumpToEndCommand}"
                                ToolTip.Tip="Jump to end">
                            <local:StrokeIcon Icon="skip-end" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="monitor-btn" Command="{Binding ToggleLoopCommand}"
                                ToolTip.Tip="Loop playback (Ctrl+L)" AutomationProperties.Name="Loop playback">
                            <local:StrokeIcon Icon="repeat" Width="13" Height="13" IconBrush="{Binding LoopIconBrush}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="monitor-btn" Command="{Binding ToggleMonitorMuteCommand}"
                                ToolTip.Tip="Mute monitor audio">
                            <local:StrokeIcon Icon="{Binding MonitorAudioIconKey}" Width="15" Height="15"/>
                        </Button>
                        <ctrls:FigSlider Minimum="0" Maximum="1" Default="1" Value="{Binding MonitorVolume}"
                                           Width="72" Height="18" VerticalAlignment="Center"
                                           ToolTip.Tip="Monitor volume"/>
                        <ComboBox ItemsSource="{Binding PreviewScaleOptions}"
                                  SelectedItem="{Binding PreviewScale}"
                                  FontSize="10" Width="84" Height="24"
                                  Background="#272a30" BorderBrush="#2d3037"
                                  BorderThickness="1" CornerRadius="6"
                                  ToolTip.Tip="Preview quality">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewScaleOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <local:StrokeIcon Icon="gauge" Width="13" Height="13"
                                          ToolTip.Tip="{Binding DecodeStatus}"
                                          IconBrush="#686c76"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="0" Background="#0b0c0e" ClipToBounds="True">
                <Grid>
                    <local:PreviewSurface x:Name="Surface"/>
                    <ctrls:LayerGizmo DataContext="{Binding Gizmo}" IsVisible="{Binding ShowOverlay, FallbackValue=False}"/>
                    <ctrls:TransformOverlay DataContext="{Binding Transform}" IsVisible="{Binding ShowOverlay, FallbackValue=False}"/>
                    <ctrls:SwirlOverlay DataContext="{Binding Swirl}" IsVisible="{Binding ShowOverlay, FallbackValue=False}"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
