<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Fig.App.Controls"
        xmlns:vm="using:Fig.App.ViewModels"
        x:Class="Fig.App.Views.ExportDialog"
        x:DataType="vm:ExportDialogViewModel"
        Title="Export Timeline"
        Width="460" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <StackPanel Margin="20" Spacing="12">

        <TextBlock Text="Export Timeline" Foreground="#dddddd"
                   FontSize="16" FontWeight="SemiBold"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Resolution" Foreground="#8a8a8a" FontSize="11"/>
            <ComboBox ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset}"
                      FontSize="12"/>
            <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Width" Foreground="#8a8a8a" FontSize="11"/>
                    <TextBox Text="{Binding Width, StringFormat={}{0}}" FontSize="12"
                             Foreground="#dddddd" Background="#1e1e1e"
                             BorderBrush="#333333" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Height" Foreground="#8a8a8a" FontSize="11"/>
                    <TextBox Text="{Binding Height, StringFormat={}{0}}" FontSize="12"
                             Foreground="#dddddd" Background="#1e1e1e"
                             BorderBrush="#333333" Padding="6,4"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SizeLabel}" Foreground="#6a6a6a" FontSize="11"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Frame rate" Foreground="#8a8a8a" FontSize="11"/>
            <TextBlock Text="{Binding FpsLabel}" Foreground="#dddddd" FontSize="12"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#8a8a8a" FontSize="11">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="CRF {0} (lower = better)">
                            <Binding Path="Quality"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="Quality" Foreground="#8a8a8a" FontSize="11"/>
            </DockPanel>
            <local:FigSlider Minimum="18" Maximum="28" Value="{Binding Quality}"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Output file" Foreground="#8a8a8a" FontSize="11"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…"
                        Click="Browse_Click" Padding="10,4" FontSize="11"
                        Margin="8,0,0,0" Background="#333333" Foreground="#cccccc"
                        BorderThickness="0" CornerRadius="3"/>
                <TextBox Text="{Binding OutputPath}" FontSize="12"
                         Foreground="#dddddd" Background="#1e1e1e"
                         BorderBrush="#333333" Padding="6,4"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" IsCancel="True"
                    Click="Cancel_Click" Padding="10,6"
                    Background="#333333" Foreground="#cccccc" BorderThickness="0" CornerRadius="3"/>
            <Button Content="Export" Width="90" IsDefault="True"
                    Click="Export_Click" Padding="10,6"
                    Background="#2a4a7a" Foreground="#ffffff" BorderThickness="0" CornerRadius="3"/>
        </StackPanel>

    </StackPanel>
</Window>
